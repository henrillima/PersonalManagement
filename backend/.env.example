# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth (usuário único) ─────────────────────────────────────────
# Gere o hash com: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('sua_senha'))"
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD_HASH=$2b$12$HASH_GERADO_AQUI

# Segredo para assinar os JWT — use uma string longa e aleatória
SECRET_KEY=coloque_uma_string_longa_e_aleatoria_aqui_pelo_menos_32_chars

# ── CORS ────────────────────────────────────────────────────────
# Separe múltiplas origens com vírgula
ALLOWED_ORIGINS=http://localhost:5173,https://seu-app.vercel.app
